{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "assets/img/creacionDeCancion.mp4",
      "assets/video/creacionDeCancion.mp4",
      "assets/video/espaciotrabajo.mp4",
      "assets/video/hero.mp4",
      "assets/video/mobileNativo.mp4",
      "assets/video/mobileapp.mp4",
      "assets/video/salidasseparadas.mp4",
      "assets/video/secciones.mp4",
      "assets/video/setslistosservicio.mp4",
      "assets/video/trasposicionsinpausa.mp4"
    ],
    "rewrites": [
      {
        "source": "/api/paddle/config",
        "run": { "serviceId": "playworship", "region": "us-east1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
