{
  "hosting": {
    "site": "play-worship",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "assets/captures/waveform-zoom-minimap.mp4",
      "assets/captures/waveform-poster.webp"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "**/*.mp4",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/paddle/config",
        "run": {
          "serviceId": "playworship",
          "region": "us-east1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/downloads/playworship-android-beta.apk",
        "destination": "https://playworship.app/downloads/playworship-android-beta.apk",
        "type": 302
      }
    ]
  }
}
